# Optional overrides. No API keys exist in this project.
# Loaded automatically — no `export` needed.

# PI_MY_CHROME_DIR=/tmp/agent-chrome
# PI_MY_CHROME_REAL=/home/you/.config/google-chrome/Default
# AGENTSEARCH_HEADLESS=1  # set 0 to watch the run
# PI_MY_CHROME_LOCALE=en-US
# PI_MY_CHROME_TIMEZONE=Europe/Zurich
# PI_MY_CHROME_PROXY=http://user:pass@proxy:port
